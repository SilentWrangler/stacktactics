[resource]
script = ExtResource("2_0y004")
event_scene = ExtResource("1_7fauh")
title = "Welcome to StackTactics"
text = "This event is here temporarily in lieu of a proper tutorial.

StackTactics is a turn-based strategy game with \"free-roam\" campaign. You can re-enter any campaign node at any time, though the encounters in the may change after the first time you clear them.

In battle, you left-click units (or use Tab) to select them, use bottom-left buttons or number keys to select abilities (moving is an ability, usually on key 1) and right-click the hex or unit you want to target. Bottom-right buttons let you select next unit (Tab), end your turn (Enter0 and sometimes deploy extra units if you have them."
options = Array[ExtResource("1_7v0j7")]([SubResource("Resource_plo2o"), SubResource("Resource_sgq28")])
metadata/_custom_type_script = "uid://cox6e8oimurq4"
